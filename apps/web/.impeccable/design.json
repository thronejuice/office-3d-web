  "narrative": {
    "northStar": "ประตูกระจกสู่ออฟฟิศ (The Glass Door to the Office)",
    "overview": "The 3D isometric office is the content; everything in 2D is a light, rounded layer floating in front of it. Controls are soft, friendly and easy to hit with a thumb, and stay out of the way of the scene.",
    "keyCharacteristics": [
      "Soft rounded rectangles (10–18px) and full pills for persistent controls.",
      "One accent (Signal Blue), four presence colors, everything else neutral.",
      "Every interactive element is at least 44×44px.",
      "Soft layered shadows only; borders are one-pixel hairlines.",
      "Status is always shape + color + text, never color alone."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Signal Blue is the only accent; selected, primary and focus all use it.",
        "section": "colors"
      },
      {
        "name": "The Presence Colors Are Not Decoration Rule",
        "body": "Green, amber, red and gray mean status only.",
        "section": "colors"
      },
      {
        "name": "The Token Rule",
        "body": "Colors come from tokens; no new literal hex in component CSS.",
        "section": "colors"
      },
      {
        "name": "The Offline Font Rule",
        "body": "Fonts ship in the build; nothing loads from a CDN.",
        "section": "typography"
      },
      {
        "name": "The Tone-Mark Rule",
        "body": "Never set Thai text tighter than normal line height or clip it with tight fixed heights.",
        "section": "typography"
      },
      {
        "name": "The Float, Don't Stack Rule",
        "body": "Only one shadowed layer over the scene per region; no shadows nested in shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use var(--surface), --ink, --muted, --line, --accent and --accent-soft for any new UI, and add dark values for any new token.",
      "Do keep every touch target at least 44×44px.",
      "Do pair every status color with its shape and a text/aria label.",
      "Do keep all copy in src/strings.th.ts.",
      "Do keep mobile panels clear of the joystick (144px bottom clearance)."
    ],
    "donts": [
      "Don't introduce a second accent color or reuse presence colors decoratively.",
      "Don't load fonts, icons or images from the internet.",
      "Don't add backdrop-filter or blur to chrome; the 3D scene is the performance budget.",
      "Don't nest shadowed cards inside shadowed panels.",
      "Don't convey state by color alone, and don't disable pinch zoom."
    ]
  }
