# ---- Network ----
# Hostname or IP people type in the browser (e.g. office.local or 10.0.0.5). Caddy issues its HTTPS cert for this name.
OFFICE_HOST=office.local
# The server's LAN IP. coturn binds to it and clients are told to use it as the TURN relay.
LAN_IP=10.0.0.5

# ---- HTTPS ----
# Default: Caddy's own internal CA ("tls internal"). To use a real certificate instead, put the files in ./certs
# and set both of these (paths as seen inside the caddy container):
# TLS_CERT_FILE=/certs/office.crt
# TLS_KEY_FILE=/certs/office.key
TLS_CERT_FILE=
TLS_KEY_FILE=

# ---- Database ----
POSTGRES_PASSWORD=change-me-db

# ---- First admin (created once, must change password at first login) ----
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-admin

# ---- TURN relay (shared secret; generate with: openssl rand -hex 24) ----
TURN_SECRET=change-me-turn
